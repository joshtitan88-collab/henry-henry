# Copy this file to secrets.toml for local development, or set these as
# environment variables in your host (Render). Do NOT commit secrets.toml.

# Required to enable the Admin dashboard:
ADMIN_PASSWORD = "change-me-to-a-long-random-string"

# Postgres in production (Render injects this automatically via render.yaml).
# Leave unset locally to use the bundled SQLite file.
# DATABASE_URL = "postgresql://user:pass@host:5432/dbname"

# Transactional email (optional — submissions still save if unset).
# SMTP_HOST = "smtp.example.com"
# SMTP_PORT = "587"
# SMTP_USERNAME = "apikey-or-username"
# SMTP_PASSWORD = "your-smtp-password"
# SMTP_FROM = "no-reply@hhinvestigations.com"
# NOTIFY_EMAIL = "joshua@hhinvestigations.com"
