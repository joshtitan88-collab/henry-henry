# Copy this file to secrets.toml for local development, or set these as
# environment variables in your host (Render). Do NOT commit secrets.toml.

# Required to enable the Admin dashboard:
ADMIN_PASSWORD = "change-me-to-a-long-random-string"

# Postgres in production (Render injects this automatically via render.yaml).
# Leave unset locally to use the bundled SQLite file.
# DATABASE_URL = "postgresql://user:pass@host:5432/dbname"

# Transactional email (optional — submissions still save if unset).
# SMTP_HOST = "smtp.example.com"
# SMTP_PORT = "587"
# SMTP_USERNAME = "apikey-or-username"
# SMTP_PASSWORD = "your-smtp-password"
# SMTP_FROM = "no-reply@hhinvestigations.com"
# NOTIFY_EMAIL = "joshua@hhinvestigations.com"

# OSINT Search data sources. The search tool works without these (username
# footprint, domain WHOIS/RDAP, and CourtListener run key-free); each key
# below lights up its corresponding source.
# HIBP_API_KEY          = ""   # haveibeenpwned.com — breach exposure (paid)
# OPENCORPORATES_API_KEY = ""  # opencorporates.com — company/officer records
# NUMVERIFY_API_KEY     = ""   # numverify.com — phone carrier/line type
# GITHUB_TOKEN          = ""   # github.com PAT — raises GitHub lookup rate limit
# COURTLISTENER_TOKEN   = ""   # courtlistener.com — higher court-search limits
# SHODAN_API_KEY        = ""   # shodan.io — host ports/services for a domain

# AI summary engine (optional). Cheapest available is used automatically:
# local Ollama first (free), then Gemini (cheap), then Claude.
# OLLAMA_HOST     = "http://localhost:11434"   # default if Ollama is running
# OLLAMA_MODEL    = "llama3.1"
# GEMINI_API_KEY  = ""                          # aistudio.google.com — cheap
# GEMINI_MODEL    = "gemini-2.0-flash"
# ANTHROPIC_API_KEY = ""                        # optional paid fallback
# ANTHROPIC_MODEL   = "claude-haiku-4-5"
